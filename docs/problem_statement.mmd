flowchart TD
    %% Styling
    classDef current fill:#e3f2fd,stroke:#1976d2,stroke-width:2px;
    classDef cause fill:#fff3e0,stroke:#f57c00,stroke-width:2px;
    classDef issue fill:#ffebee,stroke:#d32f2f,stroke-width:2px,color:#b71c1c;
    classDef core fill:#ef5350,stroke:#b71c1c,stroke-width:3px,color:#fff;
    classDef solution fill:#e8f5e9,stroke:#388e3c,stroke-width:3px,color:#1b5e20;

    %% Nodes
    A["Current State:<br>Manage projects with cross-functional<br>teams & shared resources"] ::: current
    B["Existing Coordination:<br>Relies on Emails, Spreadsheets,<br>& Messaging Tools"] ::: cause
    
    subgraph Fragmented Systems Cause
        direction TB
        C["Poor Real-time Visibility<br>of Tasks & Status"] ::: issue
        D["Inefficient Workload<br>Distribution"] ::: issue
        E["Delays Due to<br>Unclear Priorities"] ::: issue
        F["Difficulty Tracking<br>Productivity & Performance"] ::: issue
    end

    G{"Core Problem:<br>Lack of Centralized, Real-Time<br>Workflow Management"} ::: core
    
    H["Proposed Solution:<br>Unified Enterprise Platform"] ::: solution

    %% Connections
    A --> B
    B -->|Leads to| C
    B -->|Leads to| D
    B -->|Leads to| E
    B -->|Leads to| F
    
    C --> G
    D --> G
    E --> G
    F --> G
    
    G ====|Resolved by|==== H
