graph TD
    classDef client fill:#e3f2fd,stroke:#1e88e5,stroke-width:2px,color:#0d47a1
    classDef server fill:#fff3e0,stroke:#fb8c00,stroke-width:2px,color:#e65100
    classDef database fill:#e8f5e9,stroke:#43a047,stroke-width:2px,color:#1b5e20
    classDef external fill:#f3e5f5,stroke:#8e24aa,stroke-width:2px,color:#4a148c

    subgraph Client Tier[Client Tier - Frontend]
        Browser["Web Browser"]:::client
        ReactApp["React / Vite Application"]:::client
        Browser -.->|Renders| ReactApp
    end

    subgraph Application Tier[Application Tier - Backend]
        APIServer["Node.js / Express API Server\n(Business Logic, RBAC, Automations)"]:::server
        WSServer["Socket.io Server\n(Real-Time Engine)"]:::server
        
        ReactApp <-->|WebSocket / WSS| WSServer
        ReactApp -->|REST API / HTTPS| APIServer
        APIServer <-->|Internal Events| WSServer
    end

    subgraph Data Tier[Data Tier]
        MongoDB[("MongoDB\n(Document Storage)")]:::database
        Redis[("Redis\n(Caching & Pub/Sub)")]:::database
        
        APIServer -->|Queries / Mongoose| MongoDB
        APIServer <-->|Session State & Cache| Redis
        WSServer <-->|User Presence Sync| Redis
    end

    subgraph External Integrations[External Integrations]
        ThirdParty["Third-Party APIs\n(Slack, MS Teams, SMTP)"]:::external
        
        APIServer -->|Webhooks / API Calls| ThirdParty
    end
